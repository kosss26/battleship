# ── Server ──
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL of this backend (used to register the Telegram webhook)
PUBLIC_URL=

# ── Database ──
DATABASE_URL=postgres://bs:bs@localhost:5432/battleship
# Set to "true" for managed Postgres that requires TLS (Railway, Render, Neon…)
DATABASE_SSL=false

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
# Lets the app run in a normal browser without Telegram (never enable in production)
ALLOW_DEV_LOGIN=true

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
# Bot username without @ and the Mini App short name (from @BotFather /newapp)
BOT_USERNAME=
APP_SHORT_NAME=play
# URL where the frontend is hosted (used for the bot's "Play" button)
WEBAPP_URL=http://localhost:3000
# Random string, Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me
# Use long polling instead of a webhook (handy for local development)
BOT_POLLING=false
# Comma-separated Telegram ids allowed to use /refund and /stats in the bot
ADMIN_IDS=
